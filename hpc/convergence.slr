#!/bin/bash
#SBATCH --job-name=convergence
#SBATCH --partition=gpu
#SBATCH --gres=gpu:nvidia_a40:1
# swap to `gpu:tesla_t4:1` for meteor (3x T4 16GB). A40 (typhoon, 48GB) is the
# better card; use the T4 when the A40s are queued or your account only has meteor.
#SBATCH --ntasks=8
#SBATCH --mem=64000MB
#SBATCH --time=24:00:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
# the gpu partition is restricted: aero_general (the default) cannot reach it,
# so this must name the research account explicitly
#SBATCH --account=aero_research_novoa

set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
export MPLBACKEND=Agg
export DATA_ROOT="$HOME/data"

mkdir -p logs
nvidia-smi

# convergence_study.py writes to results/convergence relative to cwd, and Slurm
# starts in the submit directory, so nothing needs copying back.
uv run python scripts/convergence_study.py
