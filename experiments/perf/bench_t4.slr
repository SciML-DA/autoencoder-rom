#!/bin/bash
# Autoencoder rewrite benchmark on meteor's T4s, one (model, latent) group per card.
# Submit from the staged bench directory (see stage.sh).
#SBATCH --job-name=aebench-t4
#SBATCH --partition=gpu
#SBATCH --account=aero_research_novoa
#SBATCH --gres=gpu:tesla_t4:1
#SBATCH --array=0-2
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32000MB
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x-%A_%a.out
#SBATCH --error=logs/%x-%A_%a.err

set -euo pipefail
cd "${SLURM_SUBMIT_DIR}"

export PATH="$HOME/.local/bin:$PATH"
export MPLBACKEND=Agg
export PYTHONUNBUFFERED=1
export DATA_ROOT="$HOME/data"
export BL_FILE="Challenge1.1_train_sub.h5"
export BL_DOWNSAMPLE="4,4"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
PY="${BENCH_PY:-$HOME/autoencoder-rom/.venv/bin/python}"

mkdir -p logs
hostname
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader

"$PY" bench.py run \
    --shard "${SLURM_ARRAY_TASK_ID}" \
    --nshards "${SLURM_ARRAY_TASK_COUNT}" \
    --out results/t4
