#!/bin/bash
#PBS -N sensors
#PBS -l select=1:ncpus=8:mem=96gb
#PBS -l walltime=04:00:00
#PBS -o logs/
#PBS -e logs/
#PBS -S /bin/bash
# PBS runs a job script under your *login* shell unless told otherwise, and the
# live-log line in hpc/lib.sh uses process substitution, which is a bash feature.
# Naming the interpreter explicitly means this does not depend on what your
# account happens to be set to.
#
# Linear baselines only -- POD-LSE and extended POD on the April experiment.
# CPU only, deliberately: both are one SVD and one small solve, so a GPU would
# sit idle. The two-branch autoencoders live in experiments/april_wake/hpc/sparse_sensors.pbs, which
# does ask for one.
#
# Run this before the GPU job. It produces the number every later claim is
# relative to, and it takes minutes rather than hours -- if the pairing or the
# drift correction is wrong, it shows up here for the price of a short CPU job.
#
# Sizing. One run is Q (31482, 6085) = 1.5 GB in float64 now the mask keeps the
# whole field. Five runs via $RUNS is (31482, 30425) = 7.7 GB, and concat_cases
# transiently holds two copies, so peak is ~19 GB against the 96 GB requested.
# Walltime is 4 h for the same reason: five runs is 30k small .npz reads off
# RDS, which is the access pattern that filesystem is worst at, and every ridge
# CV solve sees 5x the snapshots.
#
#   qsub experiments/april_wake/hpc/sensors.pbs
#   qsub -v FORCE_LAG=-25 experiments/april_wake/hpc/sensors.pbs      # after the lag calibration

set -euo pipefail
source "${PBS_O_WORKDIR:-$PWD}/hpc/lib.sh"
hpc_init

# Read straight from the project space rather than staging. The Challenge1.1 job
# stages a 34 GB h5 to $TMPDIR because it re-reads it every epoch; here the
# snapshots are read once into memory, so a copy would only add a copy.
#
# If a later job does re-read them, stage first -- 6085 small .npz files is a lot
# of metadata operations against a shared filesystem, which is exactly the access
# pattern RDS is worst at:
#   cp -r "$RDS_ROOT/4p5d_10ms_yaw_0_0_0/piv_snapshots_highres" "$TMPDIR/"

# `--branches` with no values: linear baselines only, no networks.
#
# Extra flags, passed through with `qsub -v EXTRA="..."`. PBS does not forward
# command-line arguments to a job script the way sbatch does, and
# `qsub -- script args` makes PBS run the file as a bare executable without
# reading its #PBS directives, so the job silently lands on the queue defaults.
# $EXTRA is the PBS-native route. It is deliberately unquoted below so it
# word-splits into separate arguments; keep each flag and value simple.
EXTRA="${EXTRA:-}"

uv run python experiments/april_wake/scripts/sparse_sensor_study.py \
    --run "${RUN:-4p5d_10ms_yaw_0_0_0}" \
    --tag "${TAG:-linear_baseline}" \
    --r-field "${R_FIELD:-64}" \
    --delays ${DELAYS:-1 5 10 25 50 100} \
    --force-lag "${FORCE_LAG:-0}" \
    --latents pod \
    --branches \
    --ridge-cv \
    --device "${DEVICE:-cpu}" \
    $EXTRA "$@"

echo "done. results in results/sparse_sensors/${TAG:-linear_baseline}/"
