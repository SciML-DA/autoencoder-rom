#!/bin/bash
# Autoencoder rewrite benchmark on one of typhoon's A40s (QoS allows one per user).
# Submit from the staged bench directory (see stage.sh).
#SBATCH --job-name=aebench-a40
#SBATCH --partition=gpu
#SBATCH --account=aero_research_novoa
#SBATCH --gres=gpu:nvidia_a40:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48000MB
#SBATCH --time=08:00:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err

set -euo pipefail
cd "${SLURM_SUBMIT_DIR}"

export PATH="$HOME/.local/bin:$PATH"
export MPLBACKEND=Agg
export PYTHONUNBUFFERED=1
export DATA_ROOT="$HOME/data"
export BL_FILE="Challenge1.1_train_sub.h5"
export BL_DOWNSAMPLE="4,4"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
PY="${BENCH_PY:-$HOME/autoencoder-rom/.venv/bin/python}"

mkdir -p logs
hostname
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader

"$PY" bench.py run --shard 0 --nshards 1 --out results/a40
