# env's 
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# data 
data/
hpc/

logs/
# personal notes and write-ups. never tracked, never referenced from
# anything in the repo -- `docs/` excludes the directory itself, so git
# does not descend into it and nothing can be force-added by accident.
docs/

# plots are regenerable, so only the csv is saved
# git cannot re-include a file whose parent dir is excluded, so `results/**`
# plus a directory re-include 
results/**
!results/**/
!results/**/results.csv
# every results folder carries a README saying which job produced it
!results/**/README.md
# performance baselines are the reference every optimisation is measured
# against, so their figures are tracked too, not just the csv
!results/performance/**/*.png
!results/performance/**/*.json
wandb/
*.o[0-9]*
*.e[0-9]*

.DS_Store
.vscode/
.ruff_cache/


# job logs, pulled from the cluster by `sync.sh pull` -- read them, do not commit them
logs/
